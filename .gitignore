# Package.resolved 정책
# - 앱 레포에서는 보통 커밋 권장
# - 라이브러리 / 모듈 레포에서는 팀 정책에 따라 ignore 가능
# Package.resolved

# =========================
# Tuist / Xcode 생성 프로젝트 파일
# =========================
# 기본 정책
# - 일반적으로 생성된 xcodeproj / xcworkspace 내부 파일은 커밋하지 않음
# - 단, CI 폴더 아래 테스트용 project / workspace 는 커밋 가능하도록 예외 허용
**/*.xcodeproj/*
**/*.xcworkspace/*

# CI 폴더 아래 xcodeproj 예외 허용
!CI/**/*.xcodeproj/project.pbxproj
!CI/**/*.xcodeproj/xcshareddata/
!CI/**/*.xcodeproj/xcshareddata/**
!CI/**/*.xcodeproj/project.xcworkspace/
!CI/**/*.xcodeproj/project.xcworkspace/xcshareddata/
!CI/**/*.xcodeproj/project.xcworkspace/xcshareddata/**

# CI 폴더 아래 xcworkspace 예외 허용
!CI/**/*.xcworkspace/contents.xcworkspacedata
!CI/**/*.xcworkspace/xcshareddata/
!CI/**/*.xcworkspace/xcshareddata/**

# Xcode가 생성하는 워크스페이스 설정 / SPM 해석 파일
**/xcshareddata/WorkspaceSettings.xcsettings
**/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# 참고
# Workspace.swift / Project.swift / Tuist.swift 는 Swift 파일이므로 영향 없음

